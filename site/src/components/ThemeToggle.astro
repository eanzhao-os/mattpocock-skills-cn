---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-select>
	<button
		class="theme-toggle"
		type="button"
		aria-label="切换主题"
		title="切换主题"
	>
		<Icon name="sun" class="theme-toggle-icon theme-toggle-icon--sun" />
		<Icon name="moon" class="theme-toggle-icon theme-toggle-icon--moon" />
	</button>
</starlight-theme-select>

<script>
	const storageKey = 'starlight-theme';
	type Theme = 'dark' | 'light';

	function getPreferredTheme(): Theme {
		return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
	}

	function getStoredTheme(): Theme | undefined {
		const theme = typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
		return theme === 'light' || theme === 'dark' ? theme : undefined;
	}

	function updateToggle(button: HTMLButtonElement, theme: Theme): void {
		const nextTheme = theme === 'light' ? 'dark' : 'light';
		button.dataset.theme = theme;
		button.setAttribute('aria-label', `切换至${nextTheme === 'light' ? '浅色' : '深色'}模式`);
		button.title = nextTheme === 'light' ? '切换至浅色模式' : '切换至深色模式';
	}

	function updateAllToggles(theme: Theme): void {
		document.querySelectorAll<HTMLButtonElement>('starlight-theme-select .theme-toggle').forEach((button) => {
			updateToggle(button, theme);
		});
	}

	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
		localStorage.setItem(storageKey, theme);
		updateAllToggles(theme);
	}

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector<HTMLButtonElement>('.theme-toggle');
			if (!button) return;

			const theme = getStoredTheme() ?? getPreferredTheme();
			document.documentElement.dataset.theme = theme;
			updateToggle(button, theme);

			button.addEventListener('click', () => {
				const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
				applyTheme(currentTheme === 'light' ? 'dark' : 'light');
			});

			matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
				if (!getStoredTheme()) {
					const systemTheme: Theme = event.matches ? 'light' : 'dark';
					document.documentElement.dataset.theme = systemTheme;
					updateAllToggles(systemTheme);
				}
			});
		}
	}

	if (!customElements.get('starlight-theme-select')) {
		customElements.define('starlight-theme-select', StarlightThemeSelect);
	}
</script>
